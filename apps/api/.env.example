DATABASE_URL=postgresql://postgres:postgres@localhost:5432/platform
JWT_SECRET=change-me-min-32-chars-random-string
PORT=3000
LOGIN_RATE_LIMIT=10
ACCOUNTING_ALLOW_SELF_APPROVAL=false
# Set HOST=:: on Railway if the web service cannot reach the API over private networking (IPv6)
HOST=0.0.0.0
# Set true in production: administrators must enable 2FA before using anything but /auth/*
REQUIRE_ADMIN_2FA=false
ADMIN_RATE_LIMIT=5
# First run without a terminal: set all three, sign in, change the password, then DELETE these variables.
# Only used when no Super Admin exists yet.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
