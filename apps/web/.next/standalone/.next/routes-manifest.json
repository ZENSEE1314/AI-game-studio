{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ],
      "regex": "^(?:/(.*))(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/accounting/reconciliation/[id]",
      "regex": "^/accounting/reconciliation/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/accounting/reconciliation/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/accounting/[id]",
      "regex": "^/accounting/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/accounting/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/accounts/[id]",
      "regex": "^/accounts/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/accounts/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/proxy/[...path]",
      "regex": "^/api/proxy/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/proxy/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/game/[id]",
      "regex": "^/game/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/game/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/accounting",
      "regex": "^/accounting(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/accounting(?:/)?$"
    },
    {
      "page": "/accounting/reconciliation",
      "regex": "^/accounting/reconciliation(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/accounting/reconciliation(?:/)?$"
    },
    {
      "page": "/accounting/reports",
      "regex": "^/accounting/reports(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/accounting/reports(?:/)?$"
    },
    {
      "page": "/accounting/setup",
      "regex": "^/accounting/setup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/accounting/setup(?:/)?$"
    },
    {
      "page": "/accounts",
      "regex": "^/accounts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/accounts(?:/)?$"
    },
    {
      "page": "/admins",
      "regex": "^/admins(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admins(?:/)?$"
    },
    {
      "page": "/audit",
      "regex": "^/audit(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/audit(?:/)?$"
    },
    {
      "page": "/credits",
      "regex": "^/credits(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/credits(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/game",
      "regex": "^/game(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/game(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/notifications",
      "regex": "^/notifications(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/notifications(?:/)?$"
    },
    {
      "page": "/play",
      "regex": "^/play(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/play(?:/)?$"
    },
    {
      "page": "/profile",
      "regex": "^/profile(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/profile(?:/)?$"
    },
    {
      "page": "/system",
      "regex": "^/system(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/system(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}